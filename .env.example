# ── Site ─────────────────────────────────────────────
# Public URL with no trailing slash. Whish sends buyers back here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=96100000000
NEXT_PUBLIC_INSTAGRAM=g.viisuals
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Show the AI-credit pack and credit balance (turn on when the AI editor ships)
NEXT_PUBLIC_AI_EDITOR=0

# ── Supabase ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Whish Pay ────────────────────────────────────────
# sandbox | production
WHISH_MODE=sandbox
WHISH_CHANNEL=
WHISH_SECRET=
# The website URL registered with Whish for your merchant account
WHISH_WEBSITE_URL=
# 1 = skip Whish entirely and approve every payment (local dev only; ignored in production mode)
WHISH_FAKE=1

# ── Panel licences ───────────────────────────────────
# Generate with: npm run keys
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=

# Downloads: the panel zip lives in the private Supabase Storage bucket "releases";
# the current file is set in src/lib/release.ts.
