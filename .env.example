# ── Site ─────────────────────────────────────────────
# Public URL with no trailing slash. Whish sends buyers back here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=96100000000
NEXT_PUBLIC_INSTAGRAM=g.viisuals
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Set to 0 to hide the AI-credit pack and credit balance
NEXT_PUBLIC_AI_EDITOR=1

# ── Supabase ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Whish Pay ────────────────────────────────────────
# sandbox | production
WHISH_MODE=sandbox
WHISH_CHANNEL=
WHISH_SECRET=
# The website URL registered with Whish for your merchant account
WHISH_WEBSITE_URL=
# 1 = skip Whish entirely and approve every payment (local dev only; ignored in production mode)
WHISH_FAKE=1

# ── Panel licences ───────────────────────────────────
# Generate with: npm run keys
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=

# Downloads: the panel zip lives in the private Supabase Storage bucket "releases";
# the current file is set in src/lib/release.ts.

# ── AI and media services (each one switches a feature on in the panel) ──
# Transcription (captions, zoom, search, AI editor) — https://console.groq.com
GROQ_API_KEY=
# AI editor and AI motions — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: a different Claude model (default claude-sonnet-5-5)
ANTHROPIC_MODEL=
# B-roll search — https://www.pexels.com/api/
PEXELS_API_KEY=
# AI sound effects — https://elevenlabs.io
ELEVENLABS_API_KEY=
